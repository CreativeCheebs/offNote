<Window
    x:Class="Offnote.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="#15171D" RowDefinitions="49,*" Opacity="0" Loaded="Root_Loaded">
        <Border x:Name="TitleBar" Grid.Row="0" Background="#1E212A" BorderBrush="#333846" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="27,Auto,*,34,34" Padding="17,0,8,0" ColumnSpacing="7" VerticalAlignment="Stretch">
                <Border Width="27" Height="27" CornerRadius="7" Background="#7389E8" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="O" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="OFFNOTE" FontSize="11" FontWeight="Bold" Foreground="#D9DEED" VerticalAlignment="Center" CharacterSpacing="160" />
                <Button x:Name="MinimizeButton" Grid.Column="3" Content="&#xE921;" AutomationProperties.Name="Minimize" Click="Minimize_Click" Style="{StaticResource ChromeButtonStyle}" />
                <Button x:Name="CloseButton" Grid.Column="4" Content="&#xE8BB;" AutomationProperties.Name="Close" Click="Close_Click" Style="{StaticResource ChromeButtonStyle}" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Padding="23,19" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <TextBlock Text="QUICK CAPTURE" FontSize="10" FontWeight="Bold" Foreground="#8296E8" CharacterSpacing="180" />
            <TextBlock Grid.Row="1" Text="Catch the thought." FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBox x:Name="NoteBox" AutomationProperties.Name="Quick note" Grid.Row="2" PlaceholderText="What's on your mind?" AcceptsReturn="True" TextWrapping="Wrap"
                     FontSize="15" Background="#20242E" Foreground="{StaticResource TextBrush}" BorderBrush="#393F4F"
                     BorderThickness="1" CornerRadius="10" Padding="11" />
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="Status" Text="VISUAL COMPARISON ONLY" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button x:Name="SaveButton" Grid.Column="1" VerticalAlignment="Center" Content="Save note" Click="Save_Click" Style="{StaticResource SaveButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
